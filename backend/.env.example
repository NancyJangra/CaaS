# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://caas:caas_secret@localhost:5432/caas
PGHOST=localhost
PGPORT=5432
PGUSER=caas
PGPASSWORD=caas_secret
PGDATABASE=caas

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS (frontend origin)
FRONTEND_URL=http://localhost:5173

# JWT (generate a long random string for production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=caas-api
JWT_AUDIENCE=caas-dashboard

# Cookie
COOKIE_NAME=caas_token
COOKIE_MAX_AGE_MS=3600000
COOKIE_SAME_SITE=lax

# Auth policy
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
LOGIN_RATE_WINDOW_SEC=900
LOGIN_RATE_MAX_ATTEMPTS=10

# Cache engine
CACHE_DEFAULT_TTL=300
CACHE_MAX_TTL=2592000
CACHE_MAX_VALUE_BYTES=1048576
CACHE_MAX_KEY_LENGTH=256
